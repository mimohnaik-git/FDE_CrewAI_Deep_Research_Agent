# Copy this file to .env and fill in whichever provider you're using:
#   cp .env.example .env
#
# You only need ONE of these â€” the app auto-detects which one is set
# (OpenAI first, then Anthropic, then a local Ollama server) unless you
# pin a provider explicitly with LLM_PROVIDER below. You can also just
# paste a key into the sidebar at runtime instead of editing this file.

# Option A â€” OpenAI (paid, default model: gpt-4o-mini)
OPENAI_API_KEY=

# Option B â€” Anthropic (paid, default model: claude-haiku-4-5)
# ANTHROPIC_API_KEY=sk-ant-...

# Option C â€” Ollama (free, fully local, default model: llama3.1)
# No key needed. Install from https://ollama.com, run `ollama serve`,
# then `ollama pull llama3.1`. Uncomment this only if Ollama runs
# somewhere other than the default http://localhost:11434.
# OLLAMA_BASE_URL=http://localhost:11434

# Optional: force a specific provider instead of auto-detecting.
# LLM_PROVIDER=openai   # openai | anthropic | ollama | auto (default)

# Optional: override the default model for whichever provider is active.
# LLM_MODEL=gpt-4o

# Optional: only needed if you give the Researcher a real web-search tool
# (see the README section "Extending the demo").
# SERPER_API_KEY=...
